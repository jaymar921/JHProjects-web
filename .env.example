# ---------------------------------------------------------------------------
# JHProjects site, environment template
#
# Copy this file to .env and fill it in. .env is git ignored; this file is not,
# so never put a real secret in here.
#
#   cp .env.example .env
#
# On Vercel these same keys go in Project Settings, Environment Variables.
# ---------------------------------------------------------------------------


# --- Database --------------------------------------------------------------
# The MongoDB connection string. Atlas gives you this under Connect, Drivers.
# Remember to URL encode the password if it contains @ : / or ?
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Which database inside the cluster the collections live in.
MONGODB_DB=jhprojects

# How many days a raw event row is kept before Mongo expires it. The rolled up
# counters in project_stats are never expired, so the totals survive this.
# Set to 0 to keep raw events forever.
ANALYTICS_EVENT_TTL_DAYS=180


# --- Privacy ---------------------------------------------------------------
# Salt for the one way hash of a visitor's IP address. The raw address is never
# stored; the hash is only used for rate limiting and unique counts.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it resets the unique visitor counts, so set it once and leave it.
ANALYTICS_HASH_SALT=replace-me-with-a-long-random-string


# --- Email, for bug reports ------------------------------------------------
# Gmail will not accept your normal account password over SMTP. You need an
# App Password:
#
#   1. Turn on 2-Step Verification at https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create a password, name it something like "JHProjects site"
#   4. Paste the 16 character value into SMTP_PASSWORD, spaces removed
#
# Port 465 is implicit TLS and is what SMTP_SECURE=true means. If your host
# blocks 465, use port 587 and set SMTP_SECURE=false, which starts the
# connection plain and upgrades it with STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-16-character-app-password

# Where bug reports are delivered.
BUG_REPORT_TO=jaymarplugins@gmail.com

# The From address. Gmail rewrites this to the authenticated account anyway
# unless the address is a verified alias, so leaving it as SMTP_USER is normal.
SMTP_FROM=your.address@gmail.com


# --- API server ------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma separated list of origins allowed to call the API from a browser.
# Leave this empty in development and any origin is allowed, which covers
# localhost and Vercel preview URLs at the same time. Set it in production.
# CORS_ALLOWED_ORIGINS=https://jhprojects.vercel.app,https://www.jhprojects.dev
CORS_ALLOWED_ORIGINS=

# Requests per window, per hashed address.
RATE_LIMIT_TRACK_PER_MINUTE=120
RATE_LIMIT_BUG_REPORT_PER_HOUR=5

# Leave empty and GET /api/stats is public. Set it and the endpoint needs
# an Authorization: Bearer <token> header.
STATS_TOKEN=


# --- Front end -------------------------------------------------------------
# Where the browser sends its events. Leave empty when the site and the API are
# on the same origin, which is the case on Vercel and, via the dev proxy in
# vite.config.js, in local development too.
# Only set this when the API is deployed somewhere else entirely.
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Set to "false" to switch view and click tracking off in the browser.
VITE_ANALYTICS_ENABLED=true
