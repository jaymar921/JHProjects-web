{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/customenchantments3",
      "destination": "/customenchantments3.html"
    },
    {
      "source": "/kumandras-economy",
      "destination": "/kumandras-economy.html"
    },
    {
      "source": "/custom-warps",
      "destination": "/custom-warps.html"
    },
    {
      "source": "/fishing-contest",
      "destination": "/fishing-contest.html"
    },
    {
      "source": "/2dgraphic-utils",
      "destination": "/2dgraphic-utils.html"
    },
    {
      "source": "/custom-enchantments-2",
      "destination": "/custom-enchantments-2.html"
    },
    {
      "source": "/more-foods-and-crops",
      "destination": "/more-foods-and-crops.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, private"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
